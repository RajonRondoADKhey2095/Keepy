# Godot 4+ specific ignores
.godot/
.import/
export.cfg
# NOTE: export_presets.cfg is intentionally NOT ignored -- it is committed
# so GitHub Actions CI can run `godot --export-release` against it.

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# Exported builds
/build/
/builds/
*.pck
*.exe
*.apk
*.aab
*.ipa
*.zip

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp
