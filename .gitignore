# Godot 4+ specific ignores
.godot/
.import/
export.cfg
# NOTE: export_presets.cfg is intentionally NOT ignored -- it is committed
# so GitHub Actions CI can run `godot --export-release` against it.

# Imported translations (automatically generated from CSV files)
*.translation

# Raw Meshy originals: track the .glb that was downloaded, and NOTHING that
# Godot derives from it on first import -- the .import sidecars, and the
# textures it extracts out of the .glb as loose _Baked_*.png / _normal.png
# files. Those appear the moment anyone runs `godot --headless --import`,
# are reproducible from the .glb, and are ~36 MB of PNG for the two assets
# imported today.
#
# Scoped to assets_source/ on purpose: `assets/**/*.import` IS tracked and
# must stay so (it carries the per-asset import settings CI exports
# against). A blanket *.import rule would block the next real asset.
#
# Worth knowing when adding a file here: export_presets.cfg uses
# export_filter="all_resources", which packs every resource in the project
# whether or not a scene references it, which is why assets_source/* sits
# in its exclude_filter -- see CLAUDE.md. Anything committed here that
# escaped that filter would ship to every mobile player as dead payload.
assets_source/**
!assets_source/**/
!assets_source/**/*.glb

# Mono-specific ignores
.mono/
data_*/

# Exported builds
/build/
/builds/
*.pck
*.exe
*.apk
*.aab
*.ipa
*.zip

# Python bytecode. scripts/dev/decimate_hazard.py imports decimate_decor.py
# rather than copying its glTF writer, so running it leaves a __pycache__
# beside them.
__pycache__/

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp

# Godot import sidecars for the recon plates under docs/. The editor imports
# every file under res:// whether or not anything references it, so a plate
# dropped in docs/color-sheets/ grows a .import the first time anyone runs
# `godot --headless --import`. They are reproducible, nothing reads them,
# and docs/* is already in export_presets.cfg's exclude_filter so they never
# reach the pack -- tracking them would be noise in every plate commit.
# Scoped to docs/ on purpose: assets/**/*.import IS tracked and must stay so.
docs/**/*.import
